# Interactive Brokers MCP Server

## Environment Variables
# See README.md for full documentation

# === IB Connection ===
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
# IB_ACCOUNT_ID=          # Optional; if omitted, uses first managed account
IB_READ_ONLY=true
IB_MODE=paper              # paper | live

# === Logging ===
LOG_LEVEL=info             # debug | info | warn | error

# === Risk Guardrails ===
RISK_MAX_ORDER_QTY=1000
RISK_MAX_ORDER_NOTIONAL=100000
RISK_DAILY_LOSS_LIMIT=10000
RISK_ALLOWED_ORDER_TYPES=MKT,LMT,STP,STP_LMT,TRAIL
# RISK_SYMBOL_ALLOWLIST=   # Optional comma-separated whitelist
# RISK_SYMBOL_DENYLIST=    # Optional comma-separated blacklist
RISK_ALLOW_OUTSIDE_RTH=false

# === Caching ===
CACHE_CONTRACT_TTL_MS=3600000
CACHE_OPTION_CHAIN_TTL_MS=1800000

# === Reconnect ===
RECONNECT_MAX_ATTEMPTS=10
RECONNECT_RESUME_SUBSCRIPTIONS=true
